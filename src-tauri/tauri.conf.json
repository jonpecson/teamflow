{
  "$schema": "https://raw.githubusercontent.com/nicorevin/tauri/refs/heads/dev/crates/tauri-cli/schema.json",
  "productName": "TeamFlow",
  "version": "0.2.0",
  "identifier": "com.teamflow.desktop",
  "build": {
    "frontendDist": "https://teamflow.statlingo.ai",
    "devUrl": "https://teamflow.statlingo.ai",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "TeamFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src * wss: ws: https: http:; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "signingIdentity": "Developer ID Application: John Anthony Pecson (R4DHNFSJKM)"
    }
  }
}
